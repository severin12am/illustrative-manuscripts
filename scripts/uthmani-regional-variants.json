{
  "_meta": {
    "title": "Uthmanic regional rasm variants",
    "definition": "Small consonantal/orthographic differences between the four ʿUthmānic regional exemplars (Syria/Ḥimṣ, Medina, Basra, Kufa) as recorded in medieval rasm literature and tested against early manuscript stemmatics — not alternate Qurans or qirāʾāt.",
    "totals_note": "Michael Cook (2004) tallies 16 Syria-unique, 13 Syria+Medina vs Basra+Kufa, and 6 Kufa-unique variants (~35 total) in Graeco-Arabica 9–10. Marijn van Putten (*Quranic Arabic*) summarizes ~40 variants in the consonantal skeleton between regional codices. Hythem Sidky (JIQSA 5, 2020) confirms four ancestral nodes by manuscript phylogeny.",
    "honest_disclaimer": "This table is illustrative of the class Cook and Sidky describe. A complete open digital census of every rasm report is still a scholarly dataset problem — we cite totals from published work; we have not re-counted or verified every report against every leaf in our corpus.",
    "window_note": "Radiocarbon and palaeography place many of our Hijazi witnesses in or near the mid-7th-century canonization window. “Stable from ~650” means an early Uthmanic Text Type archetype, not zero scribal variation thereafter."
  },
  "scholarship": [
    {
      "label": "Michael Cook, “The stemma of the regional codices of the Koran” (Graeco-Arabica 9–10, 2004)",
      "url": "https://doi.org/10.1163/9789004693623_009"
    },
    {
      "label": "Hythem Sidky, “On the Regionality of Qurʾānic Codices” (JIQSA 5, 2020)",
      "url": "https://doi.org/10.5913/jiqsa.5.2020.a005"
    },
    {
      "label": "Marijn van Putten, *Quranic Arabic* (Cambridge, 2024) — ch. on Uthmanic stemmatics",
      "url": "https://doi.org/10.1163/9789004693623_009"
    },
    {
      "label": "Yasin Dutton on Codex Parisino-Petropolitanus & BL Or. 2165 (JQS)",
      "url": "https://doi.org/10.3366/jqs.2001.3.1.71"
    },
    {
      "label": "Corpus Coranicum — manuscript catalog (CC BY 4.0 metadata)",
      "url": "https://corpuscoranicum.org/en/manuscripts"
    },
    {
      "label": "Alrahawan & Said, correlating early fragments to ʿUthmānic codices (al-Burhān 5:2, 2021)",
      "url": "https://doi.org/10.31436/alburhn.v5i2.174"
    }
  ],
  "stemma": {
    "caption": "Uncontaminated stemma implied by Cook’s regional tallies (16 / 13 / 6). Sidky’s phylogeny of early manuscripts recovers the same four ancestral nodes; the Syrian exemplar was likely sent to Ḥimṣ, not Damascus.",
    "groups": {
      "syria_medina": "13 variants where Syria and Medina share one rasm vs Basra and Kufa",
      "syria_unique": "16 variants where Syria alone differs from Medina, Basra, and Kufa",
      "kufa_unique": "6 variants where Kufa alone differs from the other three"
    },
    "neo_basran_note": "Sidky identifies a later neo-Basran subgroup — a local orthographic reform on the Basran line, distinct from the original Basran exemplar readings in rasm literature."
  },
